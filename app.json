{
  "expo": {
    "name": "krs32",
    "slug": "krs32",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/krs32-appicon.png",
    "scheme": "krs32",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/krs32-appicon-android-foreground.png",
        "backgroundImage": "./assets/images/krs32-appicon-android-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.krs32"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
